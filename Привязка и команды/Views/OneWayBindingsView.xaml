<UserControl x:Class="Привязка_и_команды.Views.OneWayBindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OneWay через ViewModel" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Изменение источника командой обновляет элементы-получатели." />
                        <ProgressBar Minimum="0" Maximum="100" Height="18" Value="{Binding Progress, Mode=OneWay}" />
                        <TextBlock Text="{Binding Progress, StringFormat=Прогресс: {0}%}" />
                        <TextBlock Text="{Binding OneWayText}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Увеличить" Command="{Binding IncreaseProgressCommand}" />
                            <Button Content="Уменьшить" Command="{Binding DecreaseProgressCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OneWayToSource" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Поле отправляет значение в источник, но не читает его обратно." />
                        <TextBox Text="{Binding SourceFromTarget, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding SourceFromTarget, StringFormat=Источник получил: {0}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Прямая OneWay-привязка" />
                        <Slider x:Name="WidthSlider" Minimum="70" Maximum="280" Value="160" />
                        <Rectangle Height="34" RadiusX="6" RadiusY="6" Fill="#50B98F"
                                   Width="{Binding ElementName=WidthSlider, Path=Value}"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="UpdateSourceTrigger" />
                        <TextBlock Text="PropertyChanged" />
                        <TextBox Text="{Binding UpdateOnPropertyChanged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding UpdateOnPropertyChanged, StringFormat=Источник: {0}}" />
                        <TextBlock Text="LostFocus" />
                        <TextBox Text="{Binding UpdateOnLostFocus, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="{Binding UpdateOnLostFocus, StringFormat=Источник: {0}}" />
                        <TextBlock Text="Explicit" />
                        <TextBox x:Name="ExplicitBox"
                                 Text="{Binding UpdateExplicit, Mode=TwoWay, UpdateSourceTrigger=Explicit}" />
                        <Button Content="Обновить источник"
                                Command="{Binding ApplyExplicitBindingCommand}"
                                CommandParameter="{Binding ElementName=ExplicitBox}" />
                        <TextBlock Text="{Binding UpdateExplicit, StringFormat=Источник: {0}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
