<UserControl x:Class="Привязка_и_команды.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Прямая привязка к элементу" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Slider меняет свойства TextBlock через ElementName." />
                        <Slider x:Name="SizeSlider" Minimum="12" Maximum="26" Value="18" Width="320" HorizontalAlignment="Left" Margin="0,12,0,10" />
                        <TextBlock Text="Размер меняется"
                                   FontWeight="SemiBold"
                                   FontSize="{Binding ElementName=SizeSlider, Path=Value}" />
                        <TextBlock Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=Текущее значение: {0:F0}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Через ViewModel" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="TextBox использует режим Binding по умолчанию." />
                        <TextBox Text="{Binding DefaultInput}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding DefaultInput}" />
                        <TextBlock Text="{Binding DefaultNote}" />
                        <Button Content="Сбросить через команду" Command="{Binding ResetDefaultCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionStyle}">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Команды" />
                    <TextBlock Text="{Binding CommandCount, StringFormat=Выполнено команд: {0}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
