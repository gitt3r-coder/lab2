<UserControl x:Class="Привязка_и_команды.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,0"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource SectionStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OneTime через ViewModel" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Значение читается один раз при создании привязки." />
                        <TextBlock FontSize="28"
                                   FontWeight="Bold"
                                   Text="{Binding SessionCode, Mode=OneTime}" />
                        <TextBlock Text="{Binding SessionCode, StringFormat=OneWay для сравнения: {0}}" />
                        <TextBlock Text="{Binding CurrentTime, StringFormat=Время генерации: {0}}" />
                        <Button Content="Сгенерировать новый код" Command="{Binding GenerateSessionCodeCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="OneTime от элемента" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Нижний TextBlock сохраняет стартовое значение TextBox." />
                        <TextBox x:Name="SourceBox" Text="Стартовое значение элемента" />
                        <TextBlock Text="{Binding ElementName=SourceBox, Path=Text, Mode=OneTime}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ElementName=SourceBox, Path=Text, Mode=OneWay, StringFormat=OneWay: {0}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionStyle}">
                <TextBlock Text="При нажатии команды источник меняется, но OneTime-представление остается прежним, а OneWay-представление обновляется." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
